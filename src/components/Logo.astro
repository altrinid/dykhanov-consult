---
import { site } from '../data/site';

interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${variant}`]} aria-label={`${site.name} — на главную`}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="10" fill="currentColor"></rect>
    <path
      d="M17 11h9v17M17 11c0 7-1.2 12.5-4 17M10 28h20M10 28v4M30 28v4"
      fill="none"
      stroke="var(--c-accent)"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Дыханов</span>
    <span class="logo__sub">Консалтинг</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    line-height: 1;
  }

  .logo__mark {
    width: 40px;
    height: 40px;
    flex: none;
  }

  .logo--dark .logo__mark {
    color: var(--c-ink);
  }

  .logo--light .logo__mark {
    color: rgb(255 255 255 / 0.08);
  }

  .logo__text {
    display: grid;
    gap: 3px;
  }

  .logo__name {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .logo__sub {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .logo--dark .logo__name {
    color: var(--c-ink);
  }

  .logo--dark .logo__sub {
    color: var(--c-accent-ink);
  }

  .logo--light .logo__name {
    color: #fff;
  }

  .logo--light .logo__sub {
    color: var(--c-accent);
  }
</style>
