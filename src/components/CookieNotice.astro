---
// Плашка нужна, только когда подключена Метрика (она ставит cookie)
const enabled = Number(import.meta.env.PUBLIC_YM_ID) > 0;
---

{
  enabled && (
    <div class="cookie" role="region" aria-label="Уведомление о cookie" hidden data-cookie>
      <p>
        Мы используем cookie и Яндекс Метрику, чтобы понимать, как посетители пользуются сайтом.
        Подробнее — в <a href="/privacy/">политике обработки персональных данных</a>.
      </p>
      <button class="btn btn--dark" type="button" data-cookie-ok>
        Понятно
      </button>
    </div>
  )
}

<script>
  const KEY = 'cookie-notice-ok';
  const box = document.querySelector<HTMLElement>('[data-cookie]');

  if (box) {
    let accepted = false;
    try {
      accepted = localStorage.getItem(KEY) === '1';
    } catch {
      // хранилище недоступно (приватный режим) — просто показываем плашку
    }

    if (!accepted) box.hidden = false;

    box.querySelector('[data-cookie-ok]')?.addEventListener('click', () => {
      box.hidden = true;
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        // ничего страшного: плашка появится снова на следующей странице
      }
    });
  }
</script>

<style>
  .cookie {
    position: fixed;
    right: 16px;
    bottom: 16px;
    left: 16px;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    max-width: 720px;
    margin-inline: auto;
    padding: 18px 20px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow);
    font-size: 0.9375rem;
  }

  .cookie[hidden] {
    display: none;
  }

  .cookie p {
    flex: 1 1 320px;
  }

  .cookie .btn {
    min-height: 44px;
  }
</style>
