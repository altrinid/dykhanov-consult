---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/news';

interface Props {
  item: CollectionEntry<'news'>;
}

const { item } = Astro.props;
const href = `/news/${item.id}/`;
---

<article class="card news-card">
  {
    item.data.cover && (
      <Image
        class="news-card__cover"
        src={item.data.cover}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 960px) 360px, 100vw"
      />
    )
  }
  <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
  <h3><a href={href}>{item.data.title}</a></h3>
  <p>{item.data.description}</p>
</article>

<style>
  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .news-card__cover {
    width: calc(100% + 2 * clamp(22px, 3vw, 32px));
    max-width: none;
    aspect-ratio: 16 / 9;
    margin: calc(-1 * clamp(22px, 3vw, 32px)) calc(-1 * clamp(22px, 3vw, 32px)) 8px;
    border-radius: var(--radius) var(--radius) 0 0;
    object-fit: cover;
  }

  time {
    color: var(--c-muted);
    font-size: 0.875rem;
  }

  h3 a {
    color: var(--c-ink);
    text-decoration: none;
  }

  /* Вся карточка кликабельна */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .news-card:hover h3 a {
    color: var(--c-accent-ink);
  }
</style>
