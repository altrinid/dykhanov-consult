---
import { Image } from 'astro:assets';
import AustriaPartners from '../components/AustriaPartners.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { universityCities } from '../data/universities';

// Если анкета в Яндекс Формах не задана, кнопка ведёт к форме заявки внизу страницы
const questionnaireHref = site.questionnaireUrl || '#contacts';
const isExternal = questionnaireHref.startsWith('http');

// TODO: услуги, кейсы и партнёров перенести со старого сайта «Образование за рубежом»
const services = [
  {
    title: 'Выбор страны и программы',
    text: 'Подбираем направления под цели, бюджет и уровень подготовки.',
  },
  {
    title: 'Подготовка документов',
    text: 'Помогаем собрать и оформить пакет документов для поступления.',
  },
  {
    title: 'Сопровождение',
    text: 'На связи на всех этапах — от подачи заявки до начала учёбы.',
  },
];
---

<BaseLayout
  title="Образование за рубежом — Дыханов Консалтинг"
  description="Подбор страны, программы и учебного заведения, подготовка документов и сопровождение поступления за рубеж. Консультации в Калининграде."
>
  <PageHero
    eyebrow="Образование за рубежом"
    title="Поступление в зарубежные учебные заведения"
    lead="Помогаем выбрать страну, программу и учебное заведение и пройти поступление без лишних ошибок."
  >
    <Fragment slot="actions">
      <a
        class="btn btn--accent"
        href={questionnaireHref}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener' : undefined}
      >
        Заполнить анкету
      </a>
      <a class="btn btn--ghost-light" href={site.phoneHref}>{site.phone}</a>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="edu-services-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Услуги</span>
        <h2 id="edu-services-title">Чем поможем</h2>
      </div>
      <div class="grid grid--3">
        {
          services.map((item) => (
            <article class="card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="unis-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Учёба в Австрии</span>
        <h2 id="unis-title">Университеты Вены, Граца и Зальцбурга</h2>
        <p>Вместе с партнёрами в Австрии помогаем выбрать университет и подготовиться к поступлению.</p>
      </div>
      <div class="cities">
        {
          universityCities.map((city) => (
            <div class="city">
              <h3>{city.city}</h3>
              <p class="city__note">{city.note}</p>
              <ul class="unis">
                {city.universities.map((uni) => (
                  <li class="uni">
                    <div class="uni__photo">
                      <Image
                        src={uni.photo.src}
                        alt={uni.photo.alt}
                        widths={[400, 600, 800, 1200]}
                        sizes="(min-width: 1180px) 360px, (min-width: 960px) 30vw, (min-width: 560px) 46vw, calc(100vw - 32px)"
                      />
                      <span class="uni__year">Основан в {uni.founded} году</span>
                    </div>
                    <div class="uni__body">
                      <h4>
                        <a href={uni.url} target="_blank" rel="noopener">
                          {uni.name}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      </h4>
                      <p class="uni__original" lang="de">
                        {uni.original}
                      </p>
                      <p class="uni__credit">
                        Фото:{' '}
                        <a href={uni.photo.source} target="_blank" rel="noopener">
                          {uni.photo.author}
                        </a>
                        ,{' '}
                        <a href={uni.photo.licenseUrl} target="_blank" rel="noopener license">
                          {uni.photo.license}
                        </a>
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="unis-note">Фотографии — Wikimedia Commons, кадрированы для сайта.</p>
    </div>
  </section>

  <AustriaPartners lead="Помогают на месте: от визовых вопросов и переезда до учёбы." />

  <section class="section section--surface" aria-labelledby="cases-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Кейсы</span>
        <h2 id="cases-title">Истории поступления</h2>
      </div>
      <p class="todo">Кейсы и продукты партнёров перенесём со старого сайта.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .cities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.6vw, 32px);
  }

  .city {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 18px;
    border-top: 3px solid var(--c-accent);
  }

  .city h3 {
    font-size: 1.5rem;
  }

  .city__note {
    margin-bottom: 12px;
    color: var(--c-muted);
  }

  /* В три колонки подписи городов занимают по две строки, чтобы карточки начинались на одной высоте */
  @media (min-width: 960px) {
    .city__note {
      min-height: 3.2em;
    }
  }

  .unis {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .uni {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: #fff;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .uni:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .uni__photo {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--c-surface);
  }

  .uni__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .uni:hover .uni__photo img {
    transform: scale(1.03);
  }

  .uni__year {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(23 8 66 / 0.8);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .uni__body {
    display: grid;
    gap: 4px;
    padding: 16px 18px 18px;
  }

  .uni__body h4 {
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .uni__body h4 a {
    color: var(--c-ink);
    text-decoration: none;
  }

  .uni__body h4 a:hover {
    color: var(--c-brand);
    text-decoration: underline;
  }

  .uni__original {
    color: var(--c-muted);
    font-size: 0.9375rem;
  }

  .uni__credit {
    margin-top: 6px;
    color: var(--c-muted);
    font-size: 0.75rem;
  }

  .uni__credit a {
    color: inherit;
  }

  .unis-note {
    margin-top: 24px;
    color: var(--c-muted);
    font-size: 0.8125rem;
  }

  @media (max-width: 959px) {
    .cities {
      grid-template-columns: 1fr;
    }

    .unis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 559px) {
    .unis {
      grid-template-columns: 1fr;
    }
  }
</style>
