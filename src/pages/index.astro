---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import PageHero from '../components/PageHero.astro';
import portrait from '../assets/img/dykhanov.jpg';
import visionPhoto from '../assets/img/vision.jpg';
import { austriaPartners } from '../data/austria';
import { partners } from '../data/partners';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { getNews } from '../lib/news';

const latestNews = (await getNews()).slice(0, 3);

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');

// Три направления — ссылки с первого экрана старого сайта
const directions = [
  {
    num: '01',
    title: 'Управленческий консалтинг',
    text: 'Стратегия, маркетинг, финансы и бизнес-процессы на основе лучших практик успешных компаний.',
    href: '/expert-consulting/',
    cta: 'Подробнее',
  },
  {
    num: '02',
    title: 'Образование за рубежом',
    text: 'Открываем молодёжи горизонты для обучения профессиям будущего в России и за рубежом.',
    href: '/education/',
    cta: 'Подробнее',
  },
  {
    num: '03',
    title: 'Бизнес-сообщество «Деловая Россия»',
    text: 'Продвигаем интересы бизнеса и добиваемся улучшения инвестклимата и регуляторной среды через диалог с органами власти.',
    href: site.head.delorosUrl,
    cta: 'Сайт «Деловой России»',
    external: true,
  },
];

// Блок «У нас есть» старого сайта
const strengths = [
  'Деловая репутация и обширные деловые связи в бизнес-сообществе на местном и российском рынках, а также за рубежом.',
  'Квалификация консультантов и более чем 20-летний опыт работы в российских и зарубежных проектах.',
  'Сложившаяся клиентская база компаний, которые дорожат своей репутацией и стремятся соответствовать мировым корпоративным стандартам, при этом работают и продолжают расти в сложных экономических условиях.',
  'Уникальные управленческие технологии в области стратегии, маркетинга, финансов, бизнес-процессов на основе лучших практик успешных компаний.',
];

// Блок «Наши конкурентные преимущества» старого сайта
const advantages = [
  'Деловая репутация и узнаваемость на местном рынке',
  'Квалификация консультантов, международный опыт и связи',
  'Сложившаяся клиентская база',
  'Уникальная для местного рынка технология работы, система качества, бизнес-процессы и консалтинговые продукты',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  alternateName: site.nameEn,
  foundingDate: '1997',
  url: `${site.url}/`,
  logo: `${site.url}/apple-touch-icon.png`,
  image: `${site.url}/og-image.png`,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: 'RU',
  },
  employee: {
    '@type': 'Person',
    name: site.head.name,
    jobTitle: site.head.role,
  },
  sameAs: site.social.map((item) => item.href),
};
---

<BaseLayout
  title="Управленческий консалтинг в Калининграде — Дыханов Консалтинг"
  description="Помогаем компаниям занять лидирующие позиции на рынке, поднять доходы и производительность труда. Более 900 проектов, система качества по ISO 9001."
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow={site.nameEn}
    title="Управленческий консалтинг в Калининграде"
    lead="Помогаем компаниям занять лидирующие позиции на рынке, поднять свои доходы и производительность труда."
    stats={site.stats}
  >
    <Fragment slot="actions">
      <a class="btn btn--accent" href="#contacts">Перезвоните нам</a>
      <a class="btn btn--ghost-light" href={site.phoneHref}>{site.phone}</a>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="directions-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Направления</span>
        <h2 id="directions-title">Чем мы занимаемся</h2>
      </div>
      <div class="grid grid--3">
        {
          directions.map((item) => (
            <article class="card direction">
              <span class="direction__num" aria-hidden="true">
                {item.num}
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a
                class="direction__link"
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                {item.cta}
                <span class="sr-only">: {item.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

      <div class="projects">
        <h3 class="projects__title">Проекты</h3>
        {
          projects.map((project) => (
            <article class="project">
              {project.images.length > 0 ? (
                <div class="project__gallery">
                  {project.images.slice(0, 5).map((img, i) => (
                    <a
                      class:list={['project__photo', { 'project__photo--main': i === 0 }]}
                      href={img.src}
                      target="_blank"
                      rel="noopener"
                    >
                      <Image
                        src={img}
                        alt={`${project.title}, фото ${i + 1}`}
                        widths={i === 0 ? [640, 1280] : [320, 640]}
                        sizes={i === 0 ? '(min-width: 960px) 640px, 100vw' : '(min-width: 960px) 320px, 50vw'}
                      />
                    </a>
                  ))}
                </div>
              ) : (
                <div class="project__placeholder" aria-hidden="true">
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M32 8v36" />
                    <path d="M32 12 14 40h18" />
                    <path d="m36 18 14 22H36" />
                    <path d="M8 46h48l-6 8H14z" />
                  </svg>
                </div>
              )}
              <div class="project__body">
                <span class="eyebrow">Проект</span>
                <h4>{project.title}</h4>
                <p>{project.text}</p>
                <a class="project__link" href={project.url} target="_blank" rel="noopener">
                  Подробнее о проекте <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--surface" id="about" aria-labelledby="about-title">
    <div class="container about">
      <figure class="about__photo">
        <Image
          src={portrait}
          alt={`${site.head.name}, ${site.head.role.toLowerCase()}`}
          widths={[420, 840]}
          sizes="(min-width: 860px) 420px, 100vw"
        />
        <figcaption>
          <strong>{site.head.name}</strong>
          <span>{site.head.role}, {site.head.company}</span>
        </figcaption>
      </figure>
      <div class="about__text">
        <span class="eyebrow">О нас</span>
        <h2 id="about-title">Консалтинг, обучение и бизнес-сообщество</h2>
        <p>
          Наши проекты охватывают широкий спектр деятельности: от внедрения инноваций, управления
          качеством, принципов корпоративного управления и других эффективных инструментов управления в
          компаниях и на рабочем месте до продвижения интересов бизнеса, улучшения инвестклимата и
          совершенствования регуляторной среды через взаимодействие с органами власти в рамках
          общероссийского бизнес-сообщества «Деловая Россия».
        </p>
        <p>
          Мы способствуем повышению профессиональных знаний на обучающих площадках России и Европы. Все,
          кто неравнодушен и стремится к развитию и повышению своего профессионального уровня, найдут в
          нашем лице поддержку для развития своего бизнеса и личностного роста.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="vision-title">
    <div class="container vision">
      <div class="vision__text">
        <span class="eyebrow">Видение</span>
        <h2 id="vision-title">Видение компании</h2>
        <p class="vision__lead">
          Компаниям помогаем занять лидирующие позиции на рынке, поднять свои доходы и
          производительность труда. Молодёжи открываем горизонты для обучения профессиям будущего в
          России и за рубежом. Всем предпринимателям помогаем создавать благоприятные условия для
          развития предпринимательства и экономического роста через бизнес-сообщество «Деловая Россия».
        </p>
        <h3>У нас есть</h3>
        <ul class="ticks">
          {strengths.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="vision__photo">
        <Image
          src={visionPhoto}
          alt=""
          widths={[480, 960]}
          sizes="(min-width: 960px) 420px, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="advantages-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Почему мы</span>
        <h2 id="advantages-title">Наши конкурентные преимущества</h2>
        <p>
          Высокий уровень качества услуг, профессионализм консультантов и деловая репутация «Дыханов
          Консалтинг» подтверждаются многолетней успешной работой, сертификацией системы менеджмента
          качества на соответствие международному стандарту ISO 9001 в 2002 году и ресертификациями в
          2005, 2008 и 2012 годах, а также более чем 900 успешными проектами в области управленческого
          консалтинга.
        </p>
      </div>
      <ol class="advantages">
        {advantages.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="qualification-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Квалификации, образование</span>
        <h2 id="qualification-title">Где учились наши консультанты</h2>
        <p>Наши консультанты прошли обучение и/или сертифицированы такими организациями, как:</p>
      </div>
      <ul class="partners">
        {
          partners.map((item) => (
            <li>
              <Image src={item.logo} alt={item.name} height={72} densities={[1, 2]} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="austria-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Международное сотрудничество</span>
        <h2 id="austria-title">Наши партнёры в Австрии</h2>
      </div>
      <ul class="people">
        {
          austriaPartners.map((person) => (
            <li class="person">
              {person.photo ? (
                <Image
                  class="person__photo"
                  src={person.photo}
                  alt={person.name}
                  width={112}
                  height={112}
                  densities={[1, 2]}
                />
              ) : (
                <span class="person__photo person__photo--initials" aria-hidden="true">
                  {initials(person.name)}
                </span>
              )}
              <div class="person__body">
                <h3>{person.name}</h3>
                <p>{person.role}</p>
                <a class="person__link" href={person.linkedin} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="currentColor"
                      d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
                    />
                  </svg>
                  Профиль в LinkedIn
                  <span class="sr-only">: {person.name}</span>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    latestNews.length > 0 && (
      <section class="section section--surface" id="releases" aria-labelledby="news-title">
        <div class="container">
          <div class="section-head news-head">
            <div>
              <span class="eyebrow">Пресс-центр</span>
              <h2 id="news-title">Наши проекты и достижения</h2>
            </div>
            <a class="btn btn--ghost" href="/news/">
              Все новости
            </a>
          </div>
          <div class="grid grid--3">
            {latestNews.map((item) => (
              <NewsCard item={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .direction {
    display: flex;
    flex-direction: column;
  }

  .direction__num {
    color: var(--c-accent-ink);
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .direction p {
    flex: 1;
  }

  .direction__link {
    display: inline-flex;
    gap: 6px;
    color: var(--c-brand);
    font-weight: 700;
    text-decoration: none;
  }

  .direction__link:hover {
    color: var(--c-accent-ink);
  }

  .about {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 860px) {
    .about {
      grid-template-columns: minmax(280px, 420px) 1fr;
    }
  }

  .about__photo {
    margin: 0;
  }

  .about__photo img {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .about__photo figcaption {
    display: grid;
    gap: 2px;
    margin-top: 14px;
  }

  .about__photo figcaption strong {
    color: var(--c-ink);
    font-size: 1.125rem;
  }

  .about__photo figcaption span {
    color: var(--c-muted);
  }

  .about__text > * + * {
    margin-top: 16px;
  }

  .vision {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .vision {
      grid-template-columns: 1fr minmax(300px, 420px);
    }
  }

  .vision__text > * + * {
    margin-top: 18px;
  }

  .vision__lead {
    font-size: 1.125rem;
  }

  .vision__text h3 {
    padding-top: 10px;
  }

  .ticks {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: 30px;
  }

  .ticks li::before {
    content: '';
    position: absolute;
    top: 0.45em;
    left: 0;
    width: 16px;
    height: 10px;
    border-left: 2.5px solid var(--c-accent-ink);
    border-bottom: 2.5px solid var(--c-accent-ink);
    transform: rotate(-45deg);
  }

  .vision__photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (max-width: 959.98px) {
    .vision__photo img {
      aspect-ratio: 16 / 9;
    }
  }

  .advantages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: clamp(16px, 2.4vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: adv;
  }

  .advantages li {
    counter-increment: adv;
    padding: 24px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.04);
    color: #fff;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .advantages li::before {
    content: counter(adv, decimal-leading-zero);
    display: block;
    margin-bottom: 14px;
    color: var(--c-accent);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
  }

  /* flex с центровкой: неполный последний ряд встаёт по центру */
  .partners {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partners li {
    display: grid;
    flex: 0 1 170px;
    place-items: center;
    min-height: 120px;
    padding: 20px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: #fff;
  }

  .partners img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 72px;
    object-fit: contain;
  }

  /* Галерея проектов в блоке «Чем мы занимаемся» */
  .projects {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .projects__title {
    margin-bottom: 20px;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem);
  }

  .project {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: #fff;
  }

  @media (min-width: 900px) {
    .project {
      grid-template-columns: 3fr 2fr;
    }
  }

  .project__gallery {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-auto-rows: minmax(120px, 1fr);
    gap: 4px;
    min-height: 320px;
  }

  .project__photo {
    display: block;
    overflow: hidden;
  }

  .project__photo--main {
    grid-row: span 2;
  }

  .project__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project__photo:hover img {
    transform: scale(1.04);
  }

  .project__placeholder {
    display: grid;
    place-items: center;
    min-height: 300px;
    background:
      radial-gradient(500px 260px at 80% 10%, rgb(201 162 77 / 0.3), transparent 60%),
      linear-gradient(160deg, var(--c-brand), var(--c-ink));
    color: var(--c-accent);
  }

  .project__placeholder svg {
    width: 96px;
    height: 96px;
    opacity: 0.85;
  }

  .project__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    padding: clamp(24px, 3.5vw, 44px);
  }

  .project__body h4 {
    margin: 0;
    color: var(--c-ink);
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .project__body p {
    color: var(--c-muted);
  }

  .project__link {
    color: var(--c-brand);
    font-weight: 700;
    text-decoration: none;
  }

  .project__link:hover {
    color: var(--c-accent-ink);
  }

  /* Партнёры в Австрии */
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(16px, 2.4vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .person {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: #fff;
  }

  .person__photo {
    flex: none;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
  }

  .person__photo--initials {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120px 80px at 80% 0%, rgb(201 162 77 / 0.45), transparent 70%),
      var(--c-brand);
    color: #fff;
    font-size: 2rem;
    font-weight: 800;
  }

  @media (max-width: 480px) {
    .person {
      gap: 16px;
    }

    .person__photo {
      width: 80px;
      height: 80px;
    }

    .person__photo--initials {
      font-size: 1.5rem;
    }
  }

  .person__body {
    display: grid;
    gap: 6px;
  }

  .person__body h3 {
    margin: 0;
  }

  .person__body p {
    color: var(--c-muted);
  }

  .person__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    color: var(--c-brand);
    font-weight: 700;
    text-decoration: none;
  }

  .person__link svg {
    width: 18px;
    height: 18px;
  }

  .person__link:hover {
