---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getNews } from '../../lib/news';

export const getStaticPaths = (async () => {
  const news = await getNews();
  return news.map((item) => ({ params: { slug: item.id }, props: { item } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout
  title={`${item.data.title} — Дыханов Консалтинг`}
  description={item.data.description}
  image={item.data.cover?.src}
>
  <article class="section">
    <div class="container article">
      <a class="article__back" href="/news/">← Все новости</a>
      <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
      <h1>{item.data.title}</h1>
      {
        item.data.cover && (
          <Image
            class="article__cover"
            src={item.data.cover}
            alt=""
            widths={[720, 1440]}
            sizes="(min-width: 800px) 720px, 100vw"
          />
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 760px;
  }

  .article > * + * {
    margin-top: 18px;
  }

  .article h1 {
    font-size: clamp(1.9rem, 1.3rem + 2.2vw, 2.8rem);
  }

  .article__back {
    display: inline-block;
    color: var(--c-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .article__back:hover {
    color: var(--c-ink);
  }

  time {
    display: block;
    color: var(--c-muted);
    font-size: 0.9375rem;
  }

  .article__cover {
    width: 100%;
    border-radius: var(--radius);
  }
</style>
